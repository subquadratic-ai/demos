# Copy to .env and fill in. The app also finds a .env in any parent folder.

# SubQ's hosted System One decision API.
SUBQ_API_KEY=
# SUBQ_API_URL=https://api.subq.ai/v1/systemone
# SUBQ_MODEL=subq-snap-latest

# SubQ's price per million input tokens.
SUBQ_PRICE_PER_MTOK=0.09

# The LLM lanes go through OpenRouter, which also reports what each call cost.
OPENROUTER_API_KEY=

# Requests in flight per model, the same for SubQ and the LLM.
# RACE_CONCURRENCY=8
