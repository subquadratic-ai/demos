# The SubQ Snap API. Every decision on the page comes from it.
# Required. Only ever read on the server.
SNAP_API_KEY=
SNAP_API_URL=https://api.subq.ai/v1/systemone
SNAP_MODEL=subq-snap-latest

# Which use case to run: a folder under usecases/, registered in
# usecases/index.ts. Empty means the first registered one (marketing).
USE_CASE=

# Snap's context window, in tokens. The upload pre-flight warns when a
# document would not fit in it. Set it to the real window size from the
# model spec.
SNAP_CONTEXT_TOKENS=262144

# Optional: a hosted PageIndex service for building trees from uploads and
# `npm run index`. Leave empty to have Snap classify the headings instead.
# The request shape in lib/pageindex/pageindexApi.ts has not been verified
# against the hosted API yet.
PAGEINDEX_API_URL=
PAGEINDEX_API_KEY=
